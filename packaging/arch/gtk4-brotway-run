#!/bin/sh
# Run a host GTK4 app over the brotway Broadway backend without touching the
# system gtk4. Points LD_LIBRARY_PATH at the private fork prefix, starts the
# fork's broadwayd, runs the app, and tears the daemon down on exit. The
# triple-Shift debug menu (gtk4-brotway-debugmenu) is resolved by broadwayd via
# PATH. Mirrors the repo's `make run-host`.
#
#   gtk4-brotway-run gtk4-widget-factory
#   BROTWAY_PORT=9000 BROTWAY_DISPLAY=:7 gtk4-brotway-run gnome-calculator
set -e

prefix=/usr/lib/gtk4-brotway
port="${BROTWAY_PORT:-8085}"
disp="${BROTWAY_DISPLAY:-:5}"

if [ "$#" -eq 0 ]; then
    echo "usage: gtk4-brotway-run <gtk4-app> [args...]" >&2
    exit 2
fi

export LD_LIBRARY_PATH="$prefix${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Broadway clients are remote browsers - the client OS/browser does IME and
# composition before events reach us. Server-side ibus is the wrong layer (and
# its immodule wants X11 symbols this broadway-only lib doesn't have). Let the
# client handle input; GTK just takes the composed characters. Override if needed.
: "${GTK_IM_MODULE:=simple}"
export GTK_IM_MODULE

"$prefix/gtk4-broadwayd" -p "$port" "$disp" &
bwd=$!
trap 'kill "$bwd" 2>/dev/null' EXIT
sleep 1

echo "brotway Broadway WebUI: http://localhost:$port  (triple-Shift = debug menu)"
GDK_BACKEND=broadway BROADWAY_DISPLAY="$disp" "$@"
